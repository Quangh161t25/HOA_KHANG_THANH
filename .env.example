# ==========================================
# CẤU HÌNH GOOGLE SHEETS & GOOGLE SERVICE ACCOUNT
# ==========================================

VITE_GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
VITE_GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id/edit
VITE_GOOGLE_SPREADSHEET_TITLE=HOA_KHANG_THANH

GOOGLE_SERVICE_ACCOUNT_TYPE=serviceaccount
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your_service_account.iam.gserviceaccount.com
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
